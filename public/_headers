/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://cloudflareinsights.com; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; object-src 'none'

# Fingerprinted by the build — safe to cache indefinitely.
/media/*
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

# Referenced by a stable name from index.html, so the build cannot fingerprint
# it — it must not inherit the immutable caching above, or a change to the theme
# bootstrap would be stuck in browsers for a year.
#
# Cloudflare applies EVERY matching rule and joins duplicate headers with a
# comma, so simply restating Cache-Control here would yield
#   "public, max-age=31536000, immutable, public, max-age=600"
# and the first max-age is the one that counts. The `!` prefix drops the
# inherited header first, then this rule sets the value it should have.
/theme-init.js
  ! Cache-Control
  Cache-Control: public, max-age=600
